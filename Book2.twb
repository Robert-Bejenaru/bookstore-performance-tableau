      <column caption='Avg. Sales per order' datatype='real' default-format='C2057%' name='[Calculation_0193025335595009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([OrderID])' />
      </column>
      <column caption='Avg. Unit Price (weighted)' datatype='real' default-format='c&quot;£&quot;#,##0.00;-&quot;£&quot;#,##0.00' name='[Calculation_0193025335664642]' role='measure' type='quantitative'>
